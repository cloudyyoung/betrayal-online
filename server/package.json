    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "dev": "tsx watch -r tsconfig-paths/register src/index.ts",
        "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings=0",
